{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint",
        "simple-import-sort"
    ],
    "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "simple-import-sort/imports": [
            "warn",
            {
                "groups": [
                    [
                        "^\\u0000",
                        "^node:",
                        "^@?\\w",
                        "^",
                        "^\\."
                    ]
                ]
            }
        ],
        "simple-import-sort/exports": "warn"
    }
}
